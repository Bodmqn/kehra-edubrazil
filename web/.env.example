# Supabase (get these from your Supabase project settings)
NEXT_PUBLIC_SUPABASE_URL=https://gjhzuxxexzptldpilfzz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Supabase service key (used by Netlify Functions — set as Netlify env var)
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_KEY=<your-service-role-key>

# Gmail SMTP (for sending reminder emails)
# 1. Create a dedicated Gmail account (e.g. kehra-edubrazil@gmail.com)
# 2. Enable 2-Step Verification: https://myaccount.google.com/security
# 3. Generate App Password: https://myaccount.google.com/apppasswords
# 4. Set these as Netlify environment variables (NOT in this file for production)
GMAIL_USER=your-dedicated-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Cron secret (random string, shared between GitHub Actions and Netlify)
# Generate with: openssl rand -hex 32
CRON_SECRET=<your-random-cron-secret>

# GitHub token (used by trigger-scrape.ts to dispatch GitHub Actions workflow)
# Set as Netlify environment variable
GITHUB_TOKEN=<your-github-token>
